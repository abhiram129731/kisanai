# KisanAI Platform Environment Variables Template
# Copy this file to '.env' and populate with your production credentials

# 1. Google Gemini AI API Configuration
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 2. Firebase Infrastructure Credentials (Authentication, Firestore, Storage)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# 3. Weather API Configuration
# Get a free API key at https://openweathermap.org
VITE_OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# 4. Map Boundary Configuration
# KisanAI uses Leaflet + OpenStreetMap for live manual tapping.
# No API key is required for OpenStreetMap layers out-of-the-box!

